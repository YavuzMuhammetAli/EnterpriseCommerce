# EnterpriseCommerce — local development environment for Docker Compose.
#
# Usage:   cp .env.example .env      (run inside deploy/docker/)
#
# LOCAL DEVELOPMENT ONLY. These are documented, publicly known placeholder values.
# Never reuse them in any shared, staging or production environment.
# .env is gitignored; never commit real credentials.

# --- SQL Server (profile: sqlserver) ---
# Must satisfy SQL Server password policy: 8+ chars, upper, lower, digit, symbol.
MSSQL_SA_PASSWORD=LocalDev_Only_Pa55word!
MSSQL_MEMORY_LIMIT_MB=2048
MSSQL_PORT=1433

# --- MongoDB (profile: mongodb) ---
MONGO_ROOT_USERNAME=localdev
MONGO_ROOT_PASSWORD=LocalDev_Only_Pa55word
MONGO_PORT=27017

# --- Redis (profile: redis) ---
REDIS_PASSWORD=LocalDev_Only_Pa55word
REDIS_PORT=6379

# --- Kafka, KRaft mode (profile: kafka) ---
# Cluster ID is an identifier, not a secret. Generate a new one with:
#   docker run --rm apache/kafka:4.4.0 /opt/kafka/bin/kafka-storage.sh random-uuid
KAFKA_CLUSTER_ID=5L6g3nShT-eMCtK--X86sw
KAFKA_EXTERNAL_PORT=9094

# --- Development mail sink (profile: mailsink) ---
# Catches Identity security emails in development. Not credentials.
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
