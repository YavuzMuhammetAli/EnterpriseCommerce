<Project>

  <!-- Central Package Management: every package version is declared here, once. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Microsoft.Extensions abstractions (Application / Infrastructure DI composition) -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.15" />
  </ItemGroup>

  <!--
    Identity persistence and protocol server (ADR-015, ADR-017).
    OpenIddict 7.9.0 is the minimum allowed version (advisory GHSA-cxgj-hwwh-855g).
    EF Core and ASP.NET Core Identity follow the pinned .NET 10 servicing release.
  -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.15" />
    <!-- Same version as the one OpenIddict resolves in Identity.Api; used for the Notification client assertion. -->
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
    <PackageVersion Include="OpenIddict.AspNetCore" Version="7.9.0" />
    <PackageVersion Include="OpenIddict.EntityFrameworkCore" Version="7.9.0" />
  </ItemGroup>

  <!-- ASP.NET Core hosts (Identity API, Gateway) -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Yarp.ReverseProxy" Version="2.3.0" />
  </ItemGroup>

  <!--
    Backend-for-frontend (ADR-016, ADR-017 section 9).
    OpenIdConnect: the first-party ASP.NET Core handler named by the Phase 2.2 design (P22 section 4.1).
    StackExchange.Redis (MIT): the session store needs atomic compare-and-set scripts for the refresh lease, which
    IDistributedCache cannot express.
  -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.15" />
    <PackageVersion Include="StackExchange.Redis" Version="3.4.29" />
  </ItemGroup>

  <!--
    Resource servers (ADR-017 section 4): every service validates access tokens locally with the standard ASP.NET Core
    JWT bearer handler. Used by Tenant & Merchant, and by the Identity tests' stand-in resource server.
  -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15" />
  </ItemGroup>

  <!--
    Messaging (ADR-023 section 1): the official Confluent .NET client for Kafka (Apache-2.0), a wrapper of the native
    librdkafka (librdkafka.redist 2.16.0, BSD-2-Clause with permissive bundled licences; native builds for win-x64,
    linux-x64, linux-arm64 and macOS). It has a net10.0 target whose only dependency is librdkafka.redist.
    Chosen over messaging frameworks (MassTransit, KafkaFlow, CAP, Wolverine), which ADR-023 rejects. It is referenced
    only by Infrastructure projects, never with Confluent.SchemaRegistry (MessagingBoundaryTests).
  -->
  <ItemGroup>
    <PackageVersion Include="Confluent.Kafka" Version="2.16.0" />
  </ItemGroup>

  <!-- Testing -->
  <ItemGroup>
    <!--
      Integration event contract tests (ADR-023 section 3, PHASE_3_S4_EVENT_FLOW.md section 8): validates serialized
      envelopes against the committed JSON Schema 2020-12 files, with format assertion. Corvus.Json.Validator
      (Apache-2.0, Corvus.JsonSchema; net10.0 target; compiles each schema with Roslyn at run time). Test-only; never
      referenced by a src project. JsonSchema.Net was not chosen: its current releases ship under a custom EULA
      (OSMFEULA), not an OSI licence. NJsonSchema (MIT) targets draft 4 and depends on Newtonsoft.Json.
    -->
    <PackageVersion Include="Corvus.Json.Validator" Version="5.8.12" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <!-- Browser tests of the BFF flows (Apache-2.0). Test-only; never referenced by a src project. -->
    <PackageVersion Include="Microsoft.Playwright" Version="1.64.1" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>

</Project>
