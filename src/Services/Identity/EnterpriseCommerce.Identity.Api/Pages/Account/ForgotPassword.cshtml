@page "/account/forgot-password"
@model EnterpriseCommerce.Identity.Api.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot your password?";
}
<h1>Forgot your password?</h1>
<p>Enter your email address. If it belongs to an account, we will send you a link to choose a new password.</p>

<form method="post">
    <label asp-for="Email">Email</label>
    <input asp-for="Email" type="email" autocomplete="username" required />
    <button type="submit">Send the link</button>
</form>

<p><a href="/account/login">Sign in</a></p>
