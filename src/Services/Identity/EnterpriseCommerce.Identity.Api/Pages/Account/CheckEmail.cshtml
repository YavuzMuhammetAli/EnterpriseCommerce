@page "/account/check-email"
@{
    ViewData["Title"] = "Check your inbox";
}
<h1>Check your inbox</h1>
<p>If the address can receive a confirmation email, we have sent one. Follow the link in it to continue.</p>
<p>Nothing arrived after a few minutes? <a href="/account/resend-confirmation">Send the email again</a>.</p>
