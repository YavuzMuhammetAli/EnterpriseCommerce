@page "/account/reset-password"
@model EnterpriseCommerce.Identity.Api.Pages.Account.ResetPasswordModel
@using EnterpriseCommerce.Identity.Application.Accounts
@{
    ViewData["Title"] = "Choose a new password";
}
<h1>Choose a new password</h1>

@if (Model.Result == PasswordUpdateStatus.Succeeded)
{
    <p role="status">Your password has been changed and every session has been signed out. <a href="/account/login">Sign in</a> with your new password.</p>
}
else if (Model.Result == PasswordUpdateStatus.Rejected)
{
    <p role="alert">This link is invalid or has expired. <a href="/account/forgot-password">Request a new link</a>.</p>
}
else
{
    @foreach (var error in Model.Errors)
    {
        <p role="alert">@error</p>
    }

    <form method="post">
        <input type="hidden" asp-for="Token" />
        <label asp-for="Input.Password">New password</label>
        <input asp-for="Input.Password" type="password" autocomplete="new-password" required />
        <label asp-for="Input.ConfirmPassword">Repeat the new password</label>
        <input asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password" required />
        <button type="submit">Change my password</button>
    </form>
}
