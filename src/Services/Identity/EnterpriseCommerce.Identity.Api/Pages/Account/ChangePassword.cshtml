@page "/account/change-password"
@model EnterpriseCommerce.Identity.Api.Pages.Account.ChangePasswordModel
@{
    ViewData["Title"] = "Change your password";
}
<h1>Change your password</h1>

@if (Model.SignInAgainRequired)
{
    <p role="status">Your password has been changed. <a href="/account/login">Sign in again</a> with your new password.</p>
}
else if (Model.Changed)
{
    <p role="status">Your password has been changed. Your other sessions have been signed out.</p>
}
else
{
    @foreach (var error in Model.Errors)
    {
        <p role="alert">@error</p>
    }

    <form method="post">
        <label asp-for="Input.CurrentPassword">Current password</label>
        <input asp-for="Input.CurrentPassword" type="password" autocomplete="current-password" required />
        <label asp-for="Input.NewPassword">New password</label>
        <input asp-for="Input.NewPassword" type="password" autocomplete="new-password" required />
        <label asp-for="Input.ConfirmPassword">Repeat the new password</label>
        <input asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password" required />
        <button type="submit">Change my password</button>
    </form>
}
