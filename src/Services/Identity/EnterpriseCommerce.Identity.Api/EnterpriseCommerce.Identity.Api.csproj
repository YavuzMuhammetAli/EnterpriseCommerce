<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Composition root of the Identity service. -->

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="OpenIddict.AspNetCore" />
    <PackageReference Include="Serilog.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EnterpriseCommerce.Identity.Application\EnterpriseCommerce.Identity.Application.csproj" />
    <ProjectReference Include="..\EnterpriseCommerce.Identity.Infrastructure\EnterpriseCommerce.Identity.Infrastructure.csproj" />
  </ItemGroup>

  <!--
    ADR-018 section 4, isolation layer 1: the development mail sink is referenced in Debug builds only, so it is never
    compiled into, or published with, a Release build. Verified by the architecture tests and the CI publish check.
  -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <ProjectReference Include="..\EnterpriseCommerce.Identity.DevMailSink\EnterpriseCommerce.Identity.DevMailSink.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EnterpriseCommerce.Identity.IntegrationTests" />
    <InternalsVisibleTo Include="EnterpriseCommerce.Identity.UnitTests" />
  </ItemGroup>

</Project>
