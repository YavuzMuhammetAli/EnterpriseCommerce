{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Yarp": "Warning"
      }
    }
  },
  "ReverseProxy": {
    "Routes": {
      "identity": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/identity/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/identity"
          }
        ]
      },
      "identity-host": {
        "ClusterId": "identity-https",
        "Match": {
          "Hosts": [
            "id.localhost:7000"
          ],
          "Path": "{**catch-all}"
        }
      },
      "identity-account": {
        "ClusterId": "identity-https",
        "RateLimiterPolicy": "identity-account",
        "Match": {
          "Hosts": [
            "id.localhost:7000"
          ],
          "Path": "/account/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5101/"
          }
        }
      },
      "identity-https": {
        "Destinations": {
          "primary": {
            "Address": "https://localhost:7101/"
          }
        }
      }
    }
  }
}
